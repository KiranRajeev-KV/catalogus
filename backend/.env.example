PORT=8080

# Render Postgres (internal URL when backend + DB are in same Render region)
DATABASE_URL="postgresql://USER:PASSWORD@RENDER_INTERNAL_HOST:5432/DATABASE"
# Usually same as DATABASE_URL unless you need a separate direct connection URL
DIRECT_URL="postgresql://USER:PASSWORD@RENDER_INTERNAL_HOST:5432/DATABASE"

# better-auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
FRONTEND_URL=
CORS_ORIGINS=

# External APIs
TMDB_API_KEY=
ANILIST_API_URL=https://graphql.anilist.co

# Upstash Redis (Redis-compatible TLS URL for ioredis, usually rediss://)
REDIS_URL="rediss://default:PASSWORD@UPSTASH_HOST:6379"
